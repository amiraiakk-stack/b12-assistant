# Claude API key from console.anthropic.com
ANTHROPIC_API_KEY=

# The student account is entered on the web page and kept in the OS password store.
# B12_EMAIL / B12_PASSWORD here are only a fallback for running without the page.
B12_EMAIL=
B12_PASSWORD=
B12_URL=https://student.b12app.com/

# WhatsApp Cloud API (developers.facebook.com > your app > WhatsApp > API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any secret string you choose; type the same value in the Meta webhook settings
WHATSAPP_VERIFY_TOKEN=
# Only this number may talk to the bot, international format without + (e.g. 9627XXXXXXXX)
ALLOWED_WHATSAPP_NUMBER=

# Local time zone and when to sync / send the morning reminder
TIMEZONE=Asia/Amman
SYNC_EVERY_HOURS=3
MORNING_REMINDER_HOUR=6
